# Copy to .env and adjust. Never commit the real .env file.
# All values below are non-sensitive placeholders for local development.

# --- PostgreSQL ---
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me-locally

# --- Backend (API + worker) ---
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:change-me-locally@postgres:5432/nexora
NEXORA_ENVIRONMENT=development
NEXORA_LOG_LEVEL=INFO

# Static key gating the admin/provider-sync endpoints. Leave empty to
# disable those endpoints entirely. Never reuse this value anywhere else.
NEXORA_ADMIN_API_KEY=

# Freshness targets (minutes) used for the `stale` flag and alerts.
NEXORA_NEWS_FRESHNESS_MINUTES=60
NEXORA_EVENT_FRESHNESS_MINUTES=1440

# Ingestion scheduling and resilience (see specs/NEWS_AND_EVENTS.md).
NEXORA_INGESTION_INTERVAL_SECONDS=900
NEXORA_INGESTION_JITTER_SECONDS=60
NEXORA_HTTP_TIMEOUT_SECONDS=10
NEXORA_MAX_RETRIES=3
NEXORA_RETRY_BACKOFF_BASE_SECONDS=1
NEXORA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
NEXORA_CIRCUIT_BREAKER_RESET_SECONDS=300
# Past this many consecutive failures (any number of open/half-open cycles),
# a provider disables itself rather than probing forever unsupervised.
NEXORA_AUTO_DISABLE_AFTER_FAILURES=15

# --- Demo data (docker-compose "demo" profile only) ---
# Points the seeded demo providers at the local static fixture server so the
# pipeline can be exercised end-to-end with zero real external calls.
SEED_DEMO_DATA=0
DEMO_FIXTURES_BASE_URL=http://demo-fixtures:80

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Real providers (see specs/DATA_SOURCES.md) ---
# SEC EDGAR requires a descriptive contact per its fair-access policy -
# replace with your own app name and a real contact address.
SEC_EDGAR_USER_AGENT=NeXora-personal-dashboard you@example.com

# Finnhub free-tier API key (sign up at finnhub.io) - not yet wired in,
# pending a small adapter fix (see conversation / DATA_SOURCES.md).
FINNHUB_API_KEY=

# --- Portfolio module (portfolio-api + portfolio-frontend) ---
# Separate Postgres database on the same server (see infra/postgres-init/).
NEXORA_PORTFOLIO_DATABASE_URL=postgresql+psycopg://nexora:change-me-locally@postgres:5432/nexora_portfolio
NEXORA_PORTFOLIO_ENVIRONMENT=development
NEXORA_PORTFOLIO_LOG_LEVEL=INFO

# Exact frontend origin(s) allowed to make credentialed (cookie-based) API
# calls - unlike the News & Events API, this one is NOT safe to leave as "*"
# (see specs/SECURITY.md).
NEXORA_PORTFOLIO_CORS_ALLOWED_ORIGINS=http://localhost:5174

# Plain HTTP for local docker-compose only. Any real deployment must serve
# this over HTTPS and set this back to true (the app's default) so the
# session cookie carries `Secure`.
NEXORA_PORTFOLIO_SESSION_COOKIE_SECURE=false

VITE_PORTFOLIO_API_BASE_URL=http://localhost:8001

# No real market-data provider is configured yet - see
# app/adapters/market_data.py and specs/DATA_SOURCES.md. Prices are entered
# manually (or, in a later PR, via CSV import) until one is proposed and
# confirmed, following the same process used for the News & Events sources.
