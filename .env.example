# Copy to .env and adjust. Never commit the real .env file.
# All values below are non-sensitive placeholders for local development.

# --- PostgreSQL ---
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me-locally

# --- Application (api + worker share this configuration) ---
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:change-me-locally@postgres:5432/nexora
NEXORA_ENVIRONMENT=development
NEXORA_LOG_LEVEL=INFO

# Plain HTTP for local docker-compose only. Any real deployment must sit
# behind HTTPS and set this back to true (the app's default) so the session
# cookie carries `Secure`.
NEXORA_SESSION_COOKIE_SECURE=false

# Comma-separated emails granted the admin role at registration. The first
# account ever registered is always an admin (self-hosted convention).
NEXORA_ADMIN_EMAILS=

# Extra browser origins allowed to call the API with credentials. Empty =
# same-origin only, which is what the docker/nginx setup and the vite dev
# proxy provide - leave empty unless you serve the SPA from another host.
NEXORA_CORS_ALLOWED_ORIGINS=

# --- Market data providers (see specs/DATA_SOURCES.md) ---
# Which adapter serves each asset family. "null" disables live data for that
# family (manual prices only); "fixture" is the offline synthetic provider
# used by tests and the demo profile.
NEXORA_MARKET_EQUITY_PROVIDER=yahoo        # yahoo | finnhub | fixture | null
NEXORA_MARKET_CRYPTO_PROVIDER=coingecko    # coingecko | fixture | null
NEXORA_MARKET_FX_PROVIDER=frankfurter      # frankfurter | fixture | null
# Quote freshness / worker cadence (minutes and seconds). Between two
# refreshes the cached quote is served with its age - never a call per view.
NEXORA_QUOTE_FRESHNESS_MINUTES=15
NEXORA_MARKET_REFRESH_INTERVAL_SECONDS=900
# Local request budgets per provider and per process, well under each
# provider's published limits. Lower them further if you share an IP.
NEXORA_YAHOO_RATE_LIMIT_PER_MINUTE=20
NEXORA_COINGECKO_RATE_LIMIT_PER_MINUTE=8
NEXORA_FINNHUB_RATE_LIMIT_PER_MINUTE=30
NEXORA_FRANKFURTER_RATE_LIMIT_PER_MINUTE=20
# Optional keys, read from the environment at call time and never stored.
# FINNHUB_API_KEY also powers the automatic company news per equity/ETF
# (free key at finnhub.io, ~60 calls/min): without it, instrument news stays
# empty and the page says why.
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# --- News & events ---
NEXORA_NEWS_FRESHNESS_MINUTES=60
NEXORA_EVENT_FRESHNESS_MINUTES=1440
NEXORA_INGESTION_INTERVAL_SECONDS=900
NEXORA_INGESTION_JITTER_SECONDS=60
NEXORA_HTTP_TIMEOUT_SECONDS=10
NEXORA_MAX_RETRIES=3
NEXORA_RETRY_BACKOFF_BASE_SECONDS=1
NEXORA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
NEXORA_CIRCUIT_BREAKER_RESET_SECONDS=300
# Past this many consecutive failures a news provider disables itself.
NEXORA_AUTO_DISABLE_AFTER_FAILURES=15
# SEC EDGAR requires a descriptive contact per its fair-access policy -
# replace with your own app name and a real contact address.
SEC_EDGAR_USER_AGENT=NeXora-personal-dashboard you@example.com

# --- Prediction (experimental, specs/PREDICTION.md) ---
# Kill switch. Off by default: enable only after reading the spec.
NEXORA_PREDICTION_ENABLED=false

# --- Demo data (docker-compose "demo" profile only) ---
# Seeds a synthetic instrument + fixture news providers served by the local
# demo-fixtures container; set the market providers to "fixture" too for a
# fully offline demo.
SEED_DEMO_DATA=0
DEMO_FIXTURES_BASE_URL=http://demo-fixtures:80
